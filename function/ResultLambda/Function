import json
import boto3

dynamodb = boto3.resource(
    "dynamodb",
    region_name="ap-south-1"
)

TABLE_NAME = "CVAnalysis"

table = dynamodb.Table(TABLE_NAME)


def lambda_handler(event, context):

    try:

        # --------------------------------
        # Get request_id from URL
        # --------------------------------

        path_parameters = event.get(
            "pathParameters",
            {}
        )

        request_id = path_parameters.get(
            "request_id"
        )

        if not request_id:

            return build_response(
                400,
                {
                    "success": False,
                    "message":
                        "request_id is required"
                }
            )

        print(
            f"Checking request: {request_id}"
        )

        # --------------------------------
        # Get DynamoDB item
        # --------------------------------

        result = table.get_item(
            Key={
                "request_id": request_id
            }
        )

        item = result.get(
            "Item"
        )

        # --------------------------------
        # Not found
        # --------------------------------

        if not item:

            return build_response(
                404,
                {
                    "success": False,
                    "message":
                        "Analysis not found"
                }
            )

        # --------------------------------
        # Processing
        # --------------------------------

        if item.get(
            "status"
        ) == "PROCESSING":

            return build_response(
                200,
                {
                    "success": True,
                    "status": "PROCESSING",
                    "message":
                        "Analysis is still being generated"
                }
            )

        # --------------------------------
        # Failed
        # --------------------------------

        if item.get(
            "status"
        ) == "FAILED":

            return build_response(
                500,
                {
                    "success": False,
                    "status": "FAILED",
                    "message":
                        "Analysis failed"
                }
            )

        # --------------------------------
        # Completed
        # --------------------------------

        return build_response(
            200,
            {
                "success": True,
                "status": "COMPLETED",

                "request_id":
                    request_id,

                "analysis":
                    item.get(
                        "analysis",
                        ""
                    ),

                "processed_at":
                    item.get(
                        "processed_at"
                    )
            }
        )

    except Exception as e:

        print(
            f"ERROR: {str(e)}"
        )

        return build_response(
            500,
            {
                "success": False,
                "message":
                    "Failed to retrieve analysis"
            }
        )


def build_response(status_code, body):

    return {
        "statusCode": status_code,

        "headers": {
            "Content-Type": "application/json",

            "Access-Control-Allow-Origin": "*",

            "Access-Control-Allow-Headers":
                "Content-Type",

            "Access-Control-Allow-Methods":
                "OPTIONS,GET"
        },

        "body": json.dumps(body)
    }
